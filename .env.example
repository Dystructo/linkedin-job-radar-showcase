# Copy this file to .env and fill in values for local runs. Never commit .env.
# In the Claude Code routine, APIFY_TOKEN is a network secret instead (see README).

# Apify API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Google Sheet tracker (Apps Script web app URL and the shared secret you set in the script)
SHEET_WEBAPP_URL=
SHEET_SHARED_SECRET=

# Optional fallback judge (Mode B): https://aistudio.google.com/apikey
GEMINI_API_KEY=
